# Offline deterministic model by default. This still runs the real Deep Agents graph.
WORKBENCH_MODEL_MODE=demo
WORKBENCH_DATA_DIR=.workbench
WORKBENCH_MAX_WORKERS=2
WORKBENCH_TEST_TIMEOUT=20

# To use a real model, set mode=openai and configure a tool-calling compatible API.
# WORKBENCH_MODEL_MODE=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=
# OPENAI_BASE_URL=https://api.openai.com/v1

