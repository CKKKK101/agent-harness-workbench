# Offline deterministic model by default. This still runs the real Deep Agents graph.
WORKBENCH_MODEL_MODE=demo
WORKBENCH_DATA_DIR=.workbench
WORKBENCH_MAX_WORKERS=2
WORKBENCH_TEST_TIMEOUT=20

# Application-owned context projection. Budgets are conservative UTF-8 estimates,
# not provider billing-token counts. Original checkpoint messages remain intact.
WORKBENCH_CONTEXT_ENABLED=true
WORKBENCH_CONTEXT_MAX_TOKENS=32768
WORKBENCH_CONTEXT_OUTPUT_RESERVE=2048
WORKBENCH_CONTEXT_MEMORY_TOKENS=1800
WORKBENCH_CONTEXT_RECENT_TURNS=2

# To use a real model, set mode=openai and configure a tool-calling compatible API.
# WORKBENCH_MODEL_MODE=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=
# OPENAI_BASE_URL=https://api.openai.com/v1

